# Copy to .env and fill in. Never commit .env.
PUBLIC_URL=http://localhost:8080

# Optional: enable SSO at boot (or configure it later in the UI: Settings -> Authentication)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional, at least 32 chars (openssl rand -hex 32). Generated and stored in /data if unset.
SESSION_SECRET=

# Optional: raises the GitHub API rate limit (or set it in the UI: Settings -> GitHub token)
GITHUB_TOKEN=
