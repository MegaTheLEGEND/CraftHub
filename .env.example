# Copy to .env. Everything is optional; SSO can also be set up in the UI (Settings).
PUBLIC_URL=http://localhost:8080
# GITHUB_TOKEN=ghp_...            # raises the GitHub API rate limit
# UPDATE_INTERVAL_MINUTES=30
# AUTO_INSTALL=false              # true = also install apps nobody has installed yet
# KEEP_VERSIONS=3
# INCLUDE_PRERELEASE=true
# SHOW_INSPIRED_BY=false          # "Like Adobe ..." lines on cards

# --- SSO (Authentik / any OIDC) ---
# OIDC_ISSUER=https://auth.example.com/application/o/crafthub/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_GROUPS_CLAIM=groups
# ALLOWED_GROUPS=
# ADMIN_GROUPS=crafthub-admins
# SESSION_SECRET=                 # openssl rand -hex 32

# --- Behind an Authentik proxy outpost instead of OIDC ---
# AUTH_MODE=headers

# --- Advanced ---
# AUTH_RECOVERY=false             # ignore saved auth and start open (lock-out recovery)
# FEED_URL=                       # empty disables ArtCraft's release feed
# GITHUB_API_URL=https://api.github.com
# GITHUB_DOWNLOAD_URL=            # mirror for https://github.com release downloads
# EXTRA_CA_FILE=/data/ca.pem
